<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI 斑馬線辨識與靜態道路硬體危險度評估系統</title>
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <!-- ONNX Runtime Web CDN -->
  <script src="https://cdn.jsdelivr.net/npm/onnxruntime-web/dist/ort.min.js"></script>

  <style>
    :root {
      --primary-dark: #0f172a;
      --secondary-dark: #1e293b;
      --accent-green: #00ff00;
      --accent-teal: #10b981;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 70px;
    }

    body {
      font-family: "Noto Sans TC", "Microsoft JhengHei", -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
    }

    /* 首頁漸層大標 */
    .hero-section {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #0f4c5c 100%);
      color: #ffffff;
      padding: 6rem 0 4.5rem;
      border-bottom: 4px solid var(--accent-teal);
    }

    .section-title {
      font-weight: 700;
      color: var(--primary-dark);
      border-left: 5px solid var(--accent-teal);
      padding-left: 12px;
      margin-bottom: 1.5rem;
    }

    .feature-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      height: 100%;
    }

    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }

    .legend-box {
      display: inline-block;
      width: 18px;
      height: 18px;
      background-color: rgba(0, 255, 0, 0.2);
      border: 2.5px solid #00ff00;
      vertical-align: middle;
      margin-right: 6px;
      border-radius: 3px;
    }

    /* 畫布容器響應式 */
    .canvas-wrapper {
      background-color: #0f172a;
      border-radius: 10px;
      padding: 12px;
      text-align: center;
      min-height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border: 1px solid #cbd5e1;
    }

    #outputCanvas {
      max-width: 100%;
      height: auto;
      border-radius: 6px;
      display: none;
    }

    /* 流程步驟卡片 */
    .pipeline-step {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1.25rem;
      position: relative;
      height: 100%;
    }

    .pipeline-badge {
      background-color: var(--primary-dark);
      color: #fff;
      font-size: 0.8rem;
      padding: 3px 10px;
      border-radius: 20px;
      display: inline-block;
      margin-bottom: 0.5rem;
    }

    /* 風險等級標籤 */
    .risk-badge {
      font-size: 1.05rem;
      padding: 0.45rem 0.9rem;
      border-radius: 6px;
      font-weight: 700;
      display: inline-block;
    }
    .risk-low { background-color: #dcfce7; color: #166534; border: 1px solid #86efac; }
    .risk-mid { background-color: #ffedd5; color: #9a3412; border: 1px solid #fdba74; }
    .risk-high { background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .risk-none { background-color: #e2e8f0; color: #475569; border: 1px solid #cbd5e1; }
  </style>
</head>
<body>

  <!-- 1. 固定
